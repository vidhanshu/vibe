generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  email        String? @unique
  password     String
  profilePhoto Media?  @relation("profile_of_user")
  bio          String?
  pronoun      String?
  gender       String?

  // session
  token String?

  posts      Post[]    @relation("posts_of_user")
  likes      Like[]    @relation("liked_by_user")
  comments   Comment[] @relation("commented_by_user")
  /**
   * The below relation may look confusing but
   * followers becomes the list of Follow where followingId = userId i.e i'm the guy who is being followed
   * followings becomes the list of Follow where followerId = userId i.e i'm the guy who is the follower of the user
   */
  followings Follow[]  @relation("followers_of_user")
  followers  Follow[]  @relation("following_of_user")
  status     Status?   @relation("status_of_user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String
  follower    User   @relation("followers_of_user", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following_of_user", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([followerId, followingId]) // Prevents duplicate follow records
  @@index([followerId]) // Optimizes queries for a user's followers
  @@index([followingId]) // Optimizes queries for a user's following
  @@map("follows")
}

model Post {
  id      String @id @default(uuid())
  title   String
  content String

  userId String
  user   User   @relation("posts_of_user", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  medias    Media[]   @relation("medias_of_post")
  likes     Like[]    @relation("likes_of_posts")
  comments  Comment[] @relation("comments_of_post")

  @@index([userId])
  @@index([userId, id])
  @@map("posts")
}

model Like {
  id String @id @default(uuid())

  postId String
  userId String
  post   Post   @relation("likes_of_posts", fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation("liked_by_user", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId]) // Ensures a user can like a post only once
  @@index([userId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id      String @id @default(uuid())
  content String

  postId String
  userId String
  post   Post   @relation("comments_of_post", fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation("commented_by_user", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([userId, id])
  @@map("comments")
}

model Media {
  id        String    @id @default(uuid())
  url       String
  key       String
  mediaType MediaType

  postId String?
  post   Post?   @relation("medias_of_post", fields: [postId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation("profile_of_user", fields: [userId], references: [id], onDelete: Cascade)

  statusId String?
  status   Status? @relation("status_of_media", fields: [statusId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@map("medias")
}

model Status {
  id String @id @default(uuid())

  // if text
  message         String?
  backgroundColor String? @default("#000000")

  // if medias
  medias Media[] @relation("status_of_media")
  userId String  @unique
  user   User    @relation("status_of_user", fields: [userId], references: [id], onDelete: Cascade)

  statusType StatusType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, id])
  @@index([createdAt])
  @@index([userId])
  @@map("statuses")
}

enum StatusType {
  media
  text
}

enum MediaType {
  image
  video
}
