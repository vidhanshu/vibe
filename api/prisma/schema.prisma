generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  name         String?
  email        String? @unique
  password     String
  profilePhoto Media?  @relation("profile_of_user")
  bio          String?
  pronoun      String?
  gender       String?

  // session
  token String?

  posts      Post[]    @relation("posts_of_user")
  likes      Like[]    @relation("liked_by_user")
  comments   Comment[] @relation("commented_by_user")
  /**
   * The below relation may look confusing but
   * followers becomes the list of Follow where followingId = userId i.e i'm the guy who is being followed
   * followings becomes the list of Follow where followerId = userId i.e i'm the guy who is the follower of the user
   */
  followings Follow[]  @relation("followers_of_user")
  followers  Follow[]  @relation("following_of_user")
  status     Status?   @relation("status_of_user")
  savedPosts Post[]    @relation("saved_posts")

  // Fields which are mostly there for relation, and won't much of a use
  statusesViewed      StatusView[]   @relation("viewed_by_user")
  participatedChats   ChatMember[]   @relation("user_chats")
  messagesSent        Message[]      @relation("sent_messages")
  createdChats        Chat[]         @relation("chat_created_by")
  notificationsFromMe Notification[] @relation("notification_by_user")
  notifications       Notification[] @relation("notification_for_user") // my notifications

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String
  follower    User   @relation("followers_of_user", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following_of_user", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([followerId, followingId]) // Prevents duplicate follow records
  @@index([followerId]) // Optimizes queries for a user's followers
  @@index([followingId]) // Optimizes queries for a user's following
  @@map("follows")
}

model Post {
  id      String @id @default(uuid())
  title   String
  content String

  userId String
  user   User   @relation("posts_of_user", fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medias        Media[]        @relation("medias_of_post")
  likes         Like[]         @relation("likes_of_posts")
  comments      Comment[]      @relation("comments_of_post")
  savedBy       User[]         @relation("saved_posts")
  notifications Notification[] @relation("notification_post")
  hashTags      HashTag[]

  @@index([userId])
  @@index([userId, id])
  @@map("posts")
}

model HashTag {
  id        String   @id @default(uuid())
  name      String
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("hash_tags")
}

model Like {
  id String @id @default(uuid())

  postId String
  userId String
  post   Post   @relation("likes_of_posts", fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation("liked_by_user", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, userId]) // Ensures a user can like a post only once
  @@index([userId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id      String @id @default(uuid())
  content String

  postId        String
  userId        String
  post          Post           @relation("comments_of_post", fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation("commented_by_user", fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[] @relation("notification_comment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([userId, id])
  @@map("comments")
}

model Media {
  id        String    @id @default(uuid())
  url       String
  key       String
  mediaType MediaType

  postId String?
  post   Post?   @relation("medias_of_post", fields: [postId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation("profile_of_user", fields: [userId], references: [id], onDelete: Cascade)

  statusId String?
  status   Status? @relation("status_of_media", fields: [statusId], references: [id], onDelete: Cascade)

  messageId String?  @unique
  message   Message? @relation("message_media", fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@map("medias")
}

model Status {
  id String @id @default(uuid())

  // if text
  message         String?
  backgroundColor String? @default("#000000")

  // if medias
  medias        Media[]        @relation("status_of_media")
  userId        String         @unique
  user          User           @relation("status_of_user", fields: [userId], references: [id], onDelete: Cascade)
  views         StatusView[]   @relation("status_views")
  statusReplies Message[]      @relation("status_reply_message")
  notifications Notification[] @relation("notification_status")

  statusType StatusType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, id])
  @@index([createdAt])
  @@index([userId])
  @@map("statuses")
}

model StatusView {
  id String @id @default(uuid())

  statusId String
  viewerId String
  status   Status @relation("status_views", fields: [statusId], references: [id], onDelete: Cascade)
  viewer   User   @relation("viewed_by_user", fields: [viewerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([viewerId, statusId])
  @@index([statusId])
  @@index([viewerId])
  @@map("status_views")
}

model Chat {
  id   String   @id @default(uuid())
  type ChatType

  // group only
  name        String?
  description String?

  participants ChatMember[] @relation("chat_members")
  messages     Message[]    @relation("chat_messages")
  createdBy    User?        @relation("chat_created_by", references: [id], fields: [createdById])
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")
}

model ChatMember {
  id       String        @id @default(uuid())
  chatId   String
  userId   String
  chat     Chat          @relation("chat_members", fields: [chatId], references: [id], onDelete: Cascade)
  user     User          @relation("user_chats", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime      @default(now())
  leftAt   DateTime?
  role     ChatGroupRole @default(MEMBER)

  @@unique([chatId, userId]) // Ensures a user can join a chat only once
  @@map("chat_members")
}

model Message {
  id                 String    @id @default(uuid())
  chatId             String
  senderId           String
  text               String?
  media              Media?    @relation("message_media")
  chat               Chat      @relation("chat_messages", fields: [chatId], references: [id], onDelete: Cascade)
  sender             User      @relation("sent_messages", fields: [senderId], references: [id], onDelete: Cascade)
  repliedToMessage   Message?  @relation("message_replies", fields: [repliedToMessageId], references: [id])
  repliedToMessageId String?
  replies            Message[] @relation("message_replies")
  isLog              Boolean   @default(false)
  isStatus           Boolean   @default(false) // previously thought status field will do the work, but it gets deleted after 24hr, causing no differentiating field left to identify if this was status reply message
  statusId           String?
  status             Status?   @relation("status_reply_message", fields: [statusId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  byUserId  String
  byUser    User             @relation("notification_by_user", references: [id], fields: [byUserId])
  forUserId String
  forUser   User             @relation("notification_for_user", references: [id], fields: [forUserId])
  type      NotificationType
  postId    String?
  post      Post?            @relation("notification_post", references: [id], fields: [postId])
  commentId String?
  comment   Comment?         @relation("notification_comment", references: [id], fields: [commentId])
  statusId  String?
  status    Status?          @relation("notification_status", references: [id], fields: [statusId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([byUserId, statusId]) // one user can react to status only once
  @@index([byUserId, forUserId, type])
  @@index([byUserId, postId, type])
  @@index([type])
  @@map("notifications")
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  MENTION
  STATUS
}

enum ChatGroupRole {
  ADMIN
  MEMBER
}

enum ChatType {
  DM
  GROUP
}

enum StatusType {
  MEDIA
  TEXT
}

enum MediaType {
  IMAGE
  VIDEO
}
